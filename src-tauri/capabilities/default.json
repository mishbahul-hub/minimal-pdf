{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "fs:allow-read-file",
    "store:default",
    "updater:default",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
