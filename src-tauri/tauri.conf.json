{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minimal PDF",
  "version": "0.2.0",
  "identifier": "com.islam.minimalpdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Minimal PDF",
        "width": 900,
        "height": 1100,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "shortDescription": "Minimalist keyboard-first PDF reader",
    "longDescription": "A fast, keyboard-first PDF reader where the page is the whole interface, with search, a table of contents, themes and annotations.",
    "publisher": "islam",
    "category": "Productivity",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCNUMwNjJEREJBNkE4QzYKUldUR3FLYmJMUVpjYThKQklLUzZEQUNmMURReGhweEdicFpUNnJjVU5PcjVHdXZmd2FheHVSZHMK",
      "endpoints": [
        "https://github.com/mishbahul-hub/minimal-pdf/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
